# AgentDesk environment. One .env per compose service; this file lists every
# variable the whole stack reads. Secrets and URLs only: contract addresses come
# from deployments/97.json through @agent-desk/schemas (AD-10).

# ---------------------------------------------------------------- shared
NODE_ENV=production
LOG_LEVEL=info
CHAIN_ID=97
# Comma-separated, tried in order through viem fallback() with three retries.
RPC_URLS=https://bsc-testnet-dataseed.bnbchain.org,https://data-seed-prebsc-1-s1.binance.org:8545,https://bsc-testnet.public.blastapi.io
EXPLORER_URL=https://testnet.bscscan.com
# Shared bearer for every /internal/* and /api/internal/* route.
INTERNAL_TOKEN=change-me-internal-token

# ------------------------------------------------------------------- web
DATABASE_URL=postgres://agentdesk:agentdesk@postgres:5432/agentdesk
# 32+ chars; encrypts the iron-session cookie.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# The public origin the agentURI is built from (AD-2). Empty falls back to a
# data: URI. pnpm doctor refuses a loopback or trycloudflare.com host here.
PUBLIC_BASE_URL=
FACILITATOR_URL=http://facilitator:4020
# Where the web app reaches the execution agent for "verify on Binance".
SPOT_EXECUTOR_URL=http://agent-spot-executor:4105

# ---------------------------------------------------------------- worker
# AES-256-GCM key for System Wallet private keys. 32 bytes, base64. Worker only.
MASTER_KEY=
# The Platform Wallet's private key, imported once by pnpm seed. Worker only.
PLATFORM_WALLET_KEY=
# Telegram chat id used by the listing verification call for notify agents.
PLATFORM_CHAT_ID=
# BNB floors; pnpm doctor asserts them and pnpm seed refuses to run below them.
WALLET_GAS_FLOOR=0.005
PLATFORM_WALLET_BNB_FLOOR=0.05
CREATOR_WALLET_BNB_FLOOR=0.02
FACILITATOR_RELAYER_BNB_FLOOR=0.05

# ----------------------------------------------------------- facilitator
# Relays every x402 settlement. Lives only in apps/facilitator.
FACILITATOR_RELAYER_KEY=
FACILITATOR_PORT=4020

# ---------------------------------------------------------------- agents
# Every agent: AGENT_PRICE is a decimal USDT string, AGENT_PAYTO an address.
AGENT_PORT=4101
AGENT_PRICE=0.01
AGENT_PAYTO=
# Where an agent reads emergency_stop and order_ceiling_usdt (AD-10).
PLATFORM_INTERNAL_URL=http://web:3000
MARKET_DATA_URL=https://data-api.binance.vision

# alpha-research only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# spot-executor only
EXCHANGE_BASE_URL=https://testnet.binance.vision
EXCHANGE_API_KEY=
EXCHANGE_PRIVATE_KEY=
# Spot Demo Mode fallback: a separate key pair against a bare host.
EXCHANGE_DEMO_API_KEY=
EXCHANGE_DEMO_PRIVATE_KEY=

# telegram-notifier only
TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_POLL=true

# ------------------------------------------------------------------ seed
SEED_TELEGRAM_CHAT_ID=
